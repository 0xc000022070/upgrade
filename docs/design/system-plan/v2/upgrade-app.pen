iewBox":[0,0,24,24],"geometry":"M18.5 1.5H21.5V4.5H18.5Z","fill":"#FF5A1F"}]},{"type":"text","id":"t632","content":"2 · asks","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#FF5A1F"}]},{"type":"frame","id":"f638","layout":"vertical","gap":8,"alignItems":"center","width":96,"children":[{"type":"frame","id":"i636","name":"slab/agent","width":32,"height":32,"layout":"none","clip":false,"children":[{"type":"path","id":"p634","x":0,"y":0,"width":32,"height":32,"viewBox":[0,0,24,24],"geometry":"M3 21V3L9 8H15L21 3V21Z M8.5 11.5L10.5 13.5L8.5 15.5L6.5 13.5Z M15.5 11.5L17.5 13.5L15.5 15.5L13.5 13.5Z","fill":"#E8E8E3","fillRule":"evenodd"},{"type":"path","id":"p635","x":0,"y":0,"width":32,"height":32,"viewBox":[0,0,24,24],"geometry":"M10.5 1H13.5V4H10.5Z","fill":"#FF5A1F"}]},{"type":"text","id":"t637","content":"codex · asks","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#FF5A1F"}]},{"type":"frame","id":"f63d","layout":"vertical","gap":8,"alignItems":"center","width":96,"children":[{"type":"frame","id":"i63b","name":"slab/drops","width":32,"height":32,"layout":"none","clip":false,"children":[{"type":"path","id":"p639","x":0,"y":0,"width":32,"height":32,"viewBox":[0,0,24,24],"geometry":"M3 11H6V18H18V11H21V21H3Z M8 3H16V7L12 11L8 7Z","fill":"#E8E8E3","fillRule":"nonzero"},{"type":"path","id":"p63a","x":0,"y":0,"width":32,"height":32,"viewBox":[0,0,24,24],"geometry":"M18.5 2H21.5V5H18.5Z","fill":"#E8E8E3"}]},{"type":"text","id":"t63c","content":"4 new","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#FF5A1F"}]}]}]},{"type":"frame","id":"f640","layout":"vertical","gap":8,"children":[{"type":"frame","id":"f63j","layout":"horizontal","alignItems":"start","gap":10,"children":[{"type":"frame","id":"f63h","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-1","children":[{"type":"text","id":"t63g","content":"1","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t63i","content":"Solid mass on the 24 grid, live area 3–21. Detail is knocked out, never drawn on top; every knockout and gap is 2 units.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#9A9FA6","lineHeight":1.5,"width":580,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f63n","layout":"horizontal","alignItems":"start","gap":10,"children":[{"type":"frame","id":"f63l","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-2","children":[{"type":"text","id":"t63k","content":"2","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t63m","content":"One 45° cut at the top right of every container glyph. Nothing else in the family is cut, so the cut is the signature.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#9A9FA6","lineHeight":1.5,"width":580,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f63r","layout":"horizontal","alignItems":"start","gap":10,"children":[{"type":"frame","id":"f63p","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-3","children":[{"type":"text","id":"t63o","content":"3","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t63q","content":"The cut is the state slot: a 3×3 badge sits in it in the signal colour. Any machine, shell, workspace or agent can say \"needs you\" without a second icon.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#9A9FA6","lineHeight":1.5,"width":580,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f63v","layout":"horizontal","alignItems":"start","gap":10,"children":[{"type":"frame","id":"f63t","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-4","children":[{"type":"text","id":"t63s","content":"4","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t63u","content":"Diamond = you or a target. Square knockouts = slots, LEDs, ports. The agent keeps the mascot's ears; the plugin is a keyed tab seated in its slot, the SPEC's keyed tab made literal.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#9A9FA6","lineHeight":1.5,"width":580,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f63z","layout":"horizontal","alignItems":"start","gap":10,"children":[{"type":"frame","id":"f63x","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-5","children":[{"type":"text","id":"t63w","content":"5","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t63y","content":"Drawn for 16, 24, 32. No strokes, so nothing thins out at 16 and nothing turns to mush on a widget.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#9A9FA6","lineHeight":1.5,"width":580,"textGrowth":"fixed-width"}]}]}]}]}]},{"type":"frame","id":"B11","layout":"vertical","x":0,"y":24000,"fill":"#050607","padding":[56,64,64,64],"gap":36,"name":"board/11 · data marks","width":"fit_content","height":"fit_content","children":[{"type":"frame","id":"f646","layout":"vertical","gap":10,"children":[{"type":"text","id":"t643","content":"11 · DATA MARKS","fontFamily":"IBM Plex Mono","fontSize":11,"fill":"#6F767F","letterSpacing":1.6},{"type":"text","id":"t644","content":"DATA MARKS_  Text screens get pictures made of their own numbers","fontFamily":"Barlow Condensed","fontSize":40,"fill":"#E8E8E3","fontWeight":"600","letterSpacing":0.3},{"type":"text","id":"t645","content":"Every mark is a number or a state the row already had: latency, load, memory, disk, tool calls, context, diff size, where a plugin works, what a shell is showing. Mono ink, small, aligned to the 8 grid. The signal colour appears only where something needs you: the full disk, the ask, the missing token, the shell waiting on an answer.","fontFamily":"IBM Plex Sans","fontSize":14,"fill":"#9A9FA6","lineHeight":1.5,"width":1100,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f6tu","layout":"vertical","gap":56,"children":[{"type":"frame","id":"f6c1","layout":"horizontal","alignItems":"start","gap":32,"children":[{"type":"frame","id":"f6bw","layout":"vertical","width":160,"gap":8,"children":[{"type":"frame","id":"f6bs","layout":"vertical","width":18,"height":18,"fill":"#F2F2EE","alignItems":"center","justifyContent":"center","cornerRadius":1,"name":"note-1","children":[{"type":"text","id":"t6br","content":"1","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#000000","fontWeight":"700"}]},{"type":"text","id":"t6bt","content":"MACHINES","fontFamily":"Barlow Condensed","fontSize":22,"fill":"#E8E8E3","fontWeight":"600"},{"type":"text","id":"t6bu","content":"Latency trace, 24h load, memory and disk as 10-cell meters, one cell per open shell.","fontFamily":"IBM Plex Sans","fontSize":11.5,"fill":"#9A9FA6","lineHeight":1.45,"width":160,"textGrowth":"fixed-width"},{"type":"text","id":"t6bv","content":"An asleep host goes dim; its trace drops out where it stopped answering.","fontFamily":"IBM Plex Sans","fontSize":11.5,"fill":"#9A9FA6","lineHeight":1.45,"width":160,"textGrowth":"fixed-width"}]},{"type":"frame","id":"f6by","layout":"vertical","gap":10,"children":[{"type":"text","id":"t6bx","content":"TODAY · TEXT","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#50555C","letterSpacing":1.2},{"type":"frame","id":"f651","layout":"vertical","width":400,"fill":"#111317","stroke":"#2E343C","strokeWidth":1,"cornerRadius":2,"clip":false,"name":"panel/machines","children":[{"type":"frame","id":"f64z","layout":"horizontal","alignItems":"center","width":"fill_container","height":36,"fill":"#15181C","padding":[0,10],"justifyContent":"space_between","stroke":"#2E343C","strokeWidth":{"bottom":1},"children":[{"type":"frame","id":"f64x","layout":"horizontal","alignItems"