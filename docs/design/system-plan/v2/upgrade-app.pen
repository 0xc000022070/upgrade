 is solid, stamped and cut, from industrial labelling and equipment status plates. 35 glyphs below cover the nav, every entity on the boards and the states. Brand marks for systems, agents and multiplexers stay as they are.","fontFamily":"IBM Plex Sans","fontSize":14,"fill":"#9A9FA6","lineHeight":1.5,"width":1100,"textGrowth":"fixed-width"},{"type":"frame","id":"f5nb","layout":"vertical","gap":6,"padding":[10,14],"stroke":"#D9A93A","strokeWidth":{"left":2},"w":1100,"children":[{"type":"text","id":"t5n8","content":"NEW THIS ROUND","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#D9A93A","fontWeight":"700","letterSpacing":1.4},{"type":"text","id":"t5n9","content":"· PLUGINS redrawn: the comb read as a broom head. Now a module whose keyed tab seats in a socket.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"},{"type":"text","id":"t5na","content":"· SEARCH redrawn: the bracket-and-diamond was unreadable. Now a cut lens with a handle, still solid.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"}]}]},{"type":"frame","id":"f642","layout":"horizontal","alignItems":"start","gap":48,"children":[{"type":"frame","id":"f5x0","layout":"vertical","gap":28,"children":[{"type":"frame","id":"f5qn","layout":"vertical","gap":6,"children":[{"type":"text","id":"t5nf","content":"NAVIGATION","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#6F767F","letterSpacing":1.2},{"type":"frame","id":"f5qm","layout":"horizontal","alignItems":"center","gap":0,"fill":"#111317","stroke":"#2E343C","strokeWidth":1,"padding":[0,8],"children":[{"type":"frame","id":"f5no","layout":"vertical","width":100,"gap":10,"alignItems":"center","padding":[12,0],"children":[{"type":"frame","id":"i5nh","name":"slab/home","width":32,"height":32,"layout":"none","clip":false,"children":[{"type":"path","id":"p5ng","x":0,"y":0,"width":32,"height":32,"viewBox":[0,0,24,24],"geometry"