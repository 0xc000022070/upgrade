0,0,100,100],"geometry":"M37.38 68.02L2.97 117.17","stroke":"#3A1A10","strokeWidth":1,"strokeLinecap":"butt","strokeLinejoin":"miter"}],"x":226,"y":10},{"type":"frame","id":"f6xg","layout":"vertical","width":340,"padding":[12,14],"gap":6,"children":[{"type":"text","id":"t6xf","content":"NEEDS YOU","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#FF5A1F","letterSpacing":1.3},{"type":"text","id":"t6x6","content":"nix build .#host-vm","fontFamily":"IBM Plex Mono","fontSize":13,"fill":"#E8E8E3","fontWeight":"500"},{"type":"text","id":"t6x7","content":"codex asks to run a command","fontFamily":"IBM Plex Mono","fontSize":11,"fill":"#6F767F"},{"type":"frame","id":"f6xa","layout":"horizontal","alignItems":"center","gap":14,"children":[{"type":"text","id":"t6x8","content":"ALLOW","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#FF5A1F","letterSpacing":1.2},{"type":"text","id":"t6x9","content":"DENY","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#9A9FA6","letterSpacing":1.2}]}],"layoutPosition":"absolute","x":0,"y":0}]},{"type":"text","id":"t6xz","content":"Only the card that needs you: the jet in its asks state, locked inside the diamond.","fontFamily":"IBM Plex Sans","fontSize":12,"fill":"#D9A93A","lineHeight":1.45,"width":340,"textGrowth":"fixed-width"}]}]},{"type":"frame","id":"f6xo","layout":"vertical","gap":8,"padding":[18,22],"fill":"#0B0D10","stroke":"#2E343C","strokeWidth":1,"width":"fill_container","children":[{"type":"text","id":"t6xi","content":"RULES","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#6F767F","letterSpacing":1.3},{"type":"text","id":"t6xj","content":"1  Texture dots are #1C2026 on #111317: visible, never readable as content.","fontFamily":"IBM Plex Sans","fontSize":12.5,"fill":"#D9A93A"},{"type":"text","id":"t6xk","content":"2  One textured card per screen. Lists, sheets, the shell and the keyboard never get it.","fontFamily":"IBM Plex Sans","fontSize":12.5,"fill":"#D9A93A"},{"type":"text","id":"t6xl","content":"3  Texture never sits under text it would cross; crop it into the free side of the card.","fontFamily":"IBM Plex Sans","fontSize":12.5,"fill":"#D9A93A"},{"type":"text","id":"t6xm","content":"4  The orange tint follows the needs-you rule: one card, only while something waits.","fontFamily":"IBM Plex Sans","fontSize":12.5,"fill":"#D9A93A"},{"type":"text","id":"t6xn","content":"5  Static. No animation in texture; motion stays in the mark itself.","fontFamily":"IBM Plex Sans","fontSize":12.5,"fill":"#D9A93A"}]}]}]}]}