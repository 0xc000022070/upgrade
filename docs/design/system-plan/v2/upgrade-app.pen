o","fontSize":9.5,"fill":"#6F767F","letterSpacing":0.6},{"type":"frame","id":"f6t6","layout":"horizontal","alignItems":"center","width":"fill_container","justifyContent":"end","gap":10,"children":[{"type":"frame","id":"f6t4","layout":"horizontal","alignItems":"center","gap":2,"children":[{"type":"rectangle","id":"r6t3","width":10,"height":8,"fill":"#00000000","stroke":"#6F767F","strokeWidth":1}]},{"type":"text","id":"t6t5","content":"ATTACH","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#E8E8E3","fontWeight":"500","letterSpacing":1.2}]}]},{"type":"frame","id":"f6ta","layout":"vertical","width":"fill_container","padding":[6,8],"fill":"#050607","stroke":"#252A31","strokeWidth":1,"gap":2,"children":[{"type":"text","id":"t6t8","content":"Oct 23 04:00 backup.service: exit 1","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#6F767F"},{"type":"text","id":"t6t9","content":"Oct 23 04:00 Failed to start backup","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#9A9FA6"}]}]}]}]}]}]}]}]},{"type":"frame","id":"B12","layout":"vertical","x":0,"y":26400,"fill":"#050607","padding":[56,64,64,64],"gap":36,"name":"board/12 · mascot","width":"fit_content","height":"fit_content","children":[{"type":"frame","id":"f6u3","layout":"vertical","gap":10,"children":[{"type":"text","id":"t6tv","content":"12 · MASCOT","fontFamily":"IBM Plex Mono","fontSize":11,"fill":"#6F767F","letterSpacing":1.6},{"type":"text","id":"t6tw","content":"MASCOT_  THE JET","fontFamily":"Barlow Condensed","fontSize":40,"fill":"#E8E8E3","fontWeight":"600","letterSpacing":0.3},{"type":"text","id":"t6tx","content":"The jet from the reference footage, kept in its footage: a grey, grainy sky drawn in dots, the jet dark against it, and thin bright HUD lines on top: the arc that tracks it, the contrails, the heading tape and the readouts. The direction for the rest is sky and space.","fontFamily":"IBM Plex Sans","fontSize":14,"fill":"#9A9FA6","lineHeight":1.5,"width":1100,"textGrowth":"fixed-width"},{"type":"frame","id":"f6u2","layout":"vertical","gap":6,"padding":[10,14],"stroke":"#D9A93A","strokeWidth":{"left":2},"w":1100,"children":[{"type":"text","id":"t6ty","content":"NEW THIS ROUND","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#D9A93A","fontWeight":"700","letterSpacing":1.4},{"type":"text","id":"ht0","content":"· Clean vector logo dropped. The mark keeps the footage look: dotted film grain with cloud blotches and a vignette, the jet as a dark shape against it.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"},{"type":"text","id":"ht1","content":"· HUD on top in thin bright lines: tracking arc, contrails, heading tape with carets, readouts.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"},{"type":"text","id":"ht2","content":"· States: the arc unwinds while working, the lines lock orange when something waits, the ring closes when done, the sky goes dark asleep.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"}]}]},{"type":"frame","id":"hf47","layout":"vertical","gap":20,"children":[{"type":"frame","id":"hf46","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"hfr","layout":"vertical","padding":[36,40],"gap":18,"fill":"#0B0D10","stroke":"#2E343C","strokeWidth":1,"alignItems":"center","justifyContent":"center","width":600,"height":600,"children":[{"type":"frame","id":"hfp","layout":"none","width":480,"height":480,"clip":true,"fill":"#08090B","cornerRadius":0,"children":[{"type":"path","id":"hp3","x":0,"y":0,"width":480,"height":480,"viewBox":[0,0,480,480],"geometry":"M3.64 0.76h1.98v1.98h-1.98ZM13.71 0.10h1.98v1.98h-1.98ZM35.43 0.84h1.98v1.98h-1.98ZM38.42 0.18h1.98v1.98h-1.98ZM44.82 0.80h1.98v1.98h-1.98ZM48.31 0.06h1.98v1.98h-1.98ZM51.28 0.18h1.98v1.98h-1.98ZM55.41 0.77h1.98v1.98h-1.98ZM61.12 0.11h1.98v1.98h-1.98ZM64.43 0.13h1.98v1