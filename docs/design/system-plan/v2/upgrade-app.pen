48","content":"· Textures redrawn from the sky: a heading tape, the jet in its arc cropped off the edge, film grain, and the orange lock.","fontFamily":"IBM Plex Sans","fontSize":13,"fill":"#D9A93A","lineHeight":1.45,"width":1080,"textGrowth":"fixed-width"}]}]},{"type":"frame","id":"f6y2","layout":"vertical","gap":24,"children":[{"type":"frame","id":"f6y1","layout":"horizontal","alignItems":"start","gap":24,"children":[{"type":"frame","id":"f6xr","layout":"vertical","gap":10,"width":340,"children":[{"type":"text","id":"t6xp","content":"A · HEADING TAPE","fontFamily":"IBM Plex Mono","fontSize":10,"fill":"#D9A93A","letterSpacing":1.3},{"type":"frame","id":"f6wo","layout":"none","width":340,"height":150,"fill":"#111317","stroke":"#2E343C","strokeWidth":1,"clip":true,"children":[{"type":"frame","id":"hf4l","layout":"none","width":340,"height":150,"children":[{"type":"frame","id":"hf4k","layout":"none","width":340,"height":26,"children":[{"type":"path","id":"hp4j","x":0,"y":0,"width":340,"height":8,"viewBox":[0,0,340,8],"geometry":"M6 0V8M24 0V4M42 0V8M60 0V4M78 0V8M96 0V4M114 0V8M132 0V4M150 0V8M168 0V4M186 0V8M204 0V4M222 0V8M240 0V4M258 0V8M276 0V4M294 0V8M312 0V4M330 0V8","stroke":"#1C2026","strokeWidth":1},{"type":"text","id":"ht49","content":"24","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":0,"y":12},{"type":"text","id":"ht4a","content":"25","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":36,"y":12},{"type":"text","id":"ht4b","content":"26","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":72,"y":12},{"type":"text","id":"ht4c","content":"27","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":108,"y":12},{"type":"text","id":"ht4d","content":"28","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":144,"y":12},{"type":"text","id":"ht4e","content":"29","fontFamily":"IBM Plex Mono","fontSize":9,"fill":"#1C2026","x":180,"y":12},{"type":"text","id":"ht4f","content":"30","fontFamily":"IBM Plex Mono","font