diff --git a/cli/src/fixture_api.rs b/cli/src/fixture_api.rs
new file mode 100644
index 0000000..4a8ae70
--- /dev/null
+++ b/cli/src/fixture_api.rs
@@ -0,0 +1,222 @@
+use serde_json::json;
+use std::io::Read;
+use std::io::Write;
+use std::net::TcpListener;
+use std::net::TcpStream;
+use std::thread;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+pub(crate) fn start() -> std::io::Result<String> {
+    let listener = TcpListener::bind(("127.0.0.1", 0))?;
+    let address = listener.local_addr()?;
+    thread::Builder::new()
+        .name("codex-fixture-api".to_string())
+        .spawn(move || {
+            for stream in listener.incoming() {
+                match stream {
+                    Ok(stream) => {
+                        let _ = thread::Builder::new()
+                            .name("codex-fixture-request".to_string())
+                            .spawn(move || {
+                                let _ = handle(stream);
+                            });
+                    }
+                    Err(_) => break,
+                }
+            }
+        })?;
+    Ok(format!("http://{address}/backend-api/"))
+}
+
+fn handle(mut stream: TcpStream) -> std::io::Result<()> {
+    stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+    let request = read_request(&mut stream)?;
+    let request_line = request
+        .split(|byte| *byte == b'\n')
+        .next()
+        .and_then(|line| std::str::from_utf8(line).ok())
+        .unwrap_or_default();
+    let mut fields = request_line.split_ascii_whitespace();
+    let method = fields.next().unwrap_or_default();
+    let path = fields.next().unwrap_or_default();
+
+    if method == "POST" && path.ends_with("/responses") {
+        return stream_response(&mut stream);
+    }
+    if method == "GET" && path.ends_with("/wham/usage") {
+        return write_json(&mut stream, 200, &usage());
+    }
+    if method == "GET" && path.ends_with("/wham/rate-limit-reset-credits") {
+        return write_json(
+            &mut stream,
+            200,
+            &json!({
+                "credits": [],
+                "available_count": 0,
+                "total_earned_count": 0
+            }),
+        );
+    }
+    if method == "GET" && path.split('?').next().is_some_and(|path| path.ends_with("/models")) {
+        return write_json(&mut stream, 200, &json!({"models": []}));
+    }
+    write_json(
+        &mut stream,
+        404,
+        &json!({"error": "unsupported fixture endpoint", "path": path}),
+    )
+}
+
+fn read_request(stream: &mut TcpStream) -> std::io::Result<Vec<u8>> {
+    const MAX_REQUEST_BYTES: usize = 8 * 1024 * 1024;
+    let mut request = Vec::new();
+    let mut buffer = [0_u8; 8192];
+    let mut expected_length = None;
+
+    loop {
+        let read = stream.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        request.extend_from_slice(&buffer[..read]);
+        if request.len() > MAX_REQUEST_BYTES {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "fixture request exceeded limit",
+            ));
+        }
+
+        if expected_length.is_none()
+            && let Some(header_end) = find_bytes(&request, b"\r\n\r\n")
+        {
+            let headers = String::from_utf8_lossy(&request[..header_end]);
+            let content_length = headers
+                .lines()
+                .find_map(|line| {
+                    let (name, value) = line.split_once(':')?;
+                    name.eq_ignore_ascii_case("content-length")
+                        .then(|| value.trim().parse::<usize>().ok())
+                        .flatten()
+                })
+                .unwrap_or(0);
+            expected_length = Some(header_end + 4 + content_length);
+        }
+
+        if expected_length.is_some_and(|length| request.len() >= length) {
+            break;
+        }
+    }
+    Ok(request)
+}
+
+fn find_bytes(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack
+        .windows(needle.len())
+        .position(|window| window == needle)
+}
+
+fn write_json(
+    stream: &mut TcpStream,
+    status: u16,
+    payload: &serde_json::Value,
+) -> std::io::Result<()> {
+    let body = serde_json::to_vec(payload)?;
+    let reason = if status == 200 { "OK" } else { "Not Found" };
+    write!(
+        stream,
+        "HTTP/1.1 {status} {reason}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+        body.len()
+    )?;
+    stream.write_all(&body)
+}
+
+fn usage() -> serde_json::Value {
+    json!({
+        "plan_type": "pro",
+        "rate_limit": {
+            "allowed": true,
+            "limit_reached": false,
+            "primary_window": {
+                "used_percent": 12,
+                "limit_window_seconds": 300,
+                "reset_after_seconds": 240,
+                "reset_at": 4102444800_u64
+            },
+            "secondary_window": {
+                "used_percent": 34,
+                "limit_window_seconds": 604800,
+                "reset_after_seconds": 86400,
+                "reset_at": 4102444800_u64
+            }
+        },
+        "credits": {
+            "has_credits": true,
+            "unlimited": false,
+            "balance": "1000"
+        }
+    })
+}
+
+fn stream_response(stream: &mut TcpStream) -> std::io::Result<()> {
+    let nonce = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    let response_id = format!("fixture-{nonce}");
+    let message_id = format!("fixture-message-{nonce}");
+    let text = "Mock Codex response streamed from the isolated host.";
+    let events = [
+        json!({
+            "type": "response.created",
+            "response": {"id": response_id}
+        }),
+        json!({
+            "type": "response.output_item.added",
+            "item": {
+                "type": "message",
+                "role": "assistant",
+                "id": message_id,
+                "content": [{"type": "output_text", "text": ""}]
+            }
+        }),
+        json!({"type": "response.output_text.delta", "delta": "Mock Codex "}),
+        json!({"type": "response.output_text.delta", "delta": "response streamed "}),
+        json!({"type": "response.output_text.delta", "delta": "from the isolated host."}),
+        json!({
+            "type": "response.output_item.done",
+            "item": {
+                "type": "message",
+                "role": "assistant",
+                "id": message_id,
+                "content": [{"type": "output_text", "text": text}]
+            }
+        }),
+        json!({
+            "type": "response.completed",
+            "response": {
+                "id": response_id,
+                "usage": {
+                    "input_tokens": 120,
+                    "input_tokens_details": {"cached_tokens": 40},
+                    "output_tokens": 12,
+                    "output_tokens_details": {"reasoning_tokens": 3},
+                    "total_tokens": 132
+                }
+            }
+        }),
+    ];
+
+    write!(
+        stream,
+        "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\nx-codex-primary-used-percent: 12\r\nx-codex-primary-window-minutes: 5\r\nx-codex-primary-reset-at: 4102444800\r\nx-codex-secondary-used-percent: 34\r\nx-codex-secondary-window-minutes: 10080\r\nx-codex-secondary-reset-at: 4102444800\r\nx-codex-credits-has-credits: true\r\nx-codex-credits-unlimited: false\r\nx-codex-credits-balance: 1000\r\n\r\n"
+    )?;
+    for event in events {
+        let kind = event["type"].as_str().unwrap_or_default();
+        write!(stream, "event: {kind}\ndata: {event}\n\n")?;
+        stream.flush()?;
+        thread::sleep(Duration::from_millis(150));
+    }
+    Ok(())
+}
