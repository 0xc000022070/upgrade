# a wheel button is 64-67, not 68-71
#
# Against xterm 4.0.0. Regenerate with `just xterm-patches`.

diff --git a/lib/src/core/mouse/button.dart b/lib/src/core/mouse/button.dart
index 53dd08b..1ed5bf5 100644
--- a/lib/src/core/mouse/button.dart
+++ b/lib/src/core/mouse/button.dart
@@ -5,21 +5,22 @@ enum TerminalMouseButton {
 
   right(id: 2),
 
-  wheelUp(id: 64 + 4, isWheel: true),
+  wheelUp(id: 64 + 0, isWheel: true),
 
-  wheelDown(id: 64 + 5, isWheel: true),
+  wheelDown(id: 64 + 1, isWheel: true),
 
-  wheelLeft(id: 64 + 6, isWheel: true),
+  wheelLeft(id: 64 + 2, isWheel: true),
 
-  wheelRight(id: 64 + 7, isWheel: true),
+  wheelRight(id: 64 + 3, isWheel: true),
   ;
 
   /// The id that is used to report a button press or release to the terminal.
   ///
-  /// Mouse wheel up / down use button IDs 4 = 0100 (binary) and 5 = 0101 (binary).
-  /// The bits three and four of the button are transposed by 64 and 128
-  /// respectively, when reporting the id of the button and have have to be
-  /// adjusted correspondingly.
+  /// Wheel buttons 4-7 are encoded with bit 6 set (64) and the button number in
+  /// the low two bits: 64 up, 65 down, 66 left, 67 right. Adding the raw button
+  /// number on top of 64 instead (68-71) sets bit 2, which is the Shift
+  /// modifier, so every wheel report would arrive as Shift+wheel. Dazzle
+  /// patch; upstream fix is TerminalStudio/xterm.dart#238.
   final int id;
 
   /// Whether this button is a mouse wheel button.
