# a program that asks what the terminal is drawn in is answered
#
# Against xterm 4.0.0. Regenerate with `just xterm-patches`.

diff --git a/lib/src/core/color.dart b/lib/src/core/color.dart
index 716219c..1c8909f 100644
--- a/lib/src/core/color.dart
+++ b/lib/src/core/color.dart
@@ -17,3 +17,39 @@ abstract class NamedColor {
   static const brightCyan = 14;
   static const brightWhite = 15;
 }
+
+/// The colours a terminal is drawn in, as the programs running inside it ask
+/// for them: `OSC 10` the foreground, `OSC 11` the background, `OSC 12` the
+/// cursor. Each is packed ARGB, of which only the low 24 bits are reported.
+///
+/// An embedder that draws its own terminal knows these and the terminal does
+/// not, so a terminal given none of them answers nothing and the program
+/// falls back to a palette of its own.
+class TerminalColors {
+  const TerminalColors({
+    required this.foreground,
+    required this.background,
+    required this.cursor,
+  });
+
+  final int foreground;
+
+  final int background;
+
+  final int cursor;
+
+  /// The colour an `OSC` slot names, or null when the slot is not one of the
+  /// three above.
+  int? operator [](int slot) {
+    switch (slot) {
+      case 10:
+        return foreground;
+      case 11:
+        return background;
+      case 12:
+        return cursor;
+      default:
+        return null;
+    }
+  }
+}
diff --git a/lib/src/core/escape/emitter.dart b/lib/src/core/escape/emitter.dart
index faf5d40..9190d7b 100644
--- a/lib/src/core/escape/emitter.dart
+++ b/lib/src/core/escape/emitter.dart
@@ -30,4 +30,16 @@ class EscapeEmitter {
   String size(int rows, int cols) {
     return '\x1b[8;$rows;${cols}t';
   }
+
+  /// The answer to `OSC <slot> ; ?`: the colour written the way xterm writes
+  /// it, each eight-bit channel doubled across the sixteen bits the format
+  /// carries. It ends the way the question did, because a program reading
+  /// until BEL never sees an answer terminated with ST.
+  String color(int slot, int color, {required bool bel}) {
+    final channels = [(color >> 16) & 0xff, (color >> 8) & 0xff, color & 0xff];
+    final rgb = channels
+        .map((channel) => (channel * 0x101).toRadixString(16).padLeft(4, '0'))
+        .join('/');
+    return '\x1b]$slot;rgb:$rgb${bel ? '\x07' : '\x1b\\'}';
+  }
 }
