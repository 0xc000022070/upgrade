+  /// `OSC 10/11/12 ; ?` asks what colour the terminal is drawn in, and the
+  /// question chains: every `?` after the first asks for the next slot in
+  /// turn. Returns false, leaving the sequence to [EscapeHandler.unknownOSC],
+  /// for anything that is not a question — a colour being set — and for a
+  /// chain that runs past the last slot there is a name for.
+  bool _oscColorQuery(int first) {
+    if (first + _osc.length - 2 > 12) {
+      return false;
+    }
+
+    for (var i = 1; i < _osc.length; i++) {
+      if (_osc[i] != '?') {
+        return false;
+      }
+    }
+
+    for (var i = 1; i < _osc.length; i++) {
+      handler.sendColor(first + i - 1, bel: _oscBel);
+    }
+
+    return true;
+  }
+
   final _osc = <String>[];
 
