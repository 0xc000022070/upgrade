+final class _SharedParagraph {
+  _SharedParagraph(this.paragraph);
+
+  final Paragraph paragraph;
+  var runs = 0;
+}
+
+final class _ShapedParagraphs {
+  static const _keepUnused = 256;
+
+  final _entries = <Object, _SharedParagraph>{};
+  final _unused = <Object>{};
+  var _disposed = false;
+
+  (Paragraph, void Function()) take(Object key, Paragraph Function() shape) {
+    final entry = _entries[key] ??= _SharedParagraph(shape());
+    if (entry.runs++ == 0) _unused.remove(key);
+    return (entry.paragraph, () => _release(key, entry));
+  }
+
+  void _release(Object key, _SharedParagraph entry) {
+    if (--entry.runs > 0) return;
+    if (_disposed || !identical(_entries[key], entry)) {
+      entry.paragraph.dispose();
+      return;
+    }
+    _unused.add(key);
+    if (_unused.length <= _keepUnused) return;
+    final oldest = _unused.first;
+    _unused.remove(oldest);
+    _entries.remove(oldest)!.paragraph.dispose();
+  }
+
+  void clear() {
+    for (final key in _unused) {
+      _entries[key]!.paragraph.dispose();
+    }
+    _unused.clear();
+    _entries.clear();
+  }
+
+  void dispose() {
+    _disposed = true;
+    clear();
+  }
+}
