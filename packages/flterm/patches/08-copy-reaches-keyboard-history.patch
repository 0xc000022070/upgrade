+/// Puts [text] on the platform clipboard where the keyboard's clipboard history keeps it.
+///
+/// The terminal field asks the keyboard not to suggest or learn, and Gboard serves such a
+/// field in incognito, which keeps no clipboard history. While an attached field takes the
+/// copy, it is reopened as a plain one until the keyboard has seen the clip, then made
+/// private again.
+Future<void> copyToClipboard(String text) async {
+  final session = TextInputSession._attached;
+  if (session == null || !session.isAttached) {
+    return Clipboard.setData(ClipboardData(text: text));
+  }
+  final open = session._reopen(private: false);
+  try {
+    await Clipboard.setData(ClipboardData(text: text));
+    await Future<void>.delayed(TextInputSession._clipboardWatch);
+  } finally {
+    if (identical(session._connection, open)) session._reopen(private: true);
+  }
+}
