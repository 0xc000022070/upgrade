index 0000000..00624e3
--- /dev/null
+++ b/lib/src/rendering/kitty_virtual_placements.dart
@@ -0,0 +1,642 @@
+import 'package:libghostty/libghostty.dart';
+import 'package:meta/meta.dart';
+
+/// Codepoint of the Kitty graphics Unicode placeholder.
+const kittyPlaceholder = 0x10EEEE;
+
+/// One horizontal run of placeholder cells that show consecutive columns of
+/// the same image row.
+///
+/// Mirrors ghostty's `graphics_unicode.Placement`: a run never spans rows.
+@immutable
+final class KittyVirtualRun {
+  final int viewportRow;
+  final int viewportCol;
+  final int width;
+  final int imageId;
+
+  /// Zero when the cells carry no underline colour.
+  final int placementId;
+
+  /// Image grid row this run shows.
+  final int imageRow;
+
+  /// Image grid column shown by the run's first cell.
+  final int imageCol;
+
+  const KittyVirtualRun({
+    required this.viewportRow,
+    required this.viewportCol,
+    required this.width,
+    required this.imageId,
+    required this.placementId,
+    required this.imageRow,
+    required this.imageCol,
+  });
+
+  @override
+  int get hashCode => Object.hash(
+    viewportRow,
+    viewportCol,
+    width,
+    imageId,
+    placementId,
+    imageRow,
+    imageCol,
+  );
+
+  @override
+  bool operator ==(Object other) =>
+      other is KittyVirtualRun &&
+      other.viewportRow == viewportRow &&
+      other.viewportCol == viewportCol &&
+      other.width == width &&
+      other.imageId == imageId &&
+      other.placementId == placementId &&
+      other.imageRow == imageRow &&
+      other.imageCol == imageCol;
+
+  @override
+  String toString() =>
+      'KittyVirtualRun(row: $viewportRow, col: $viewportCol, width: $width, '
+      'image: $imageId, placement: $placementId, '
+      'imageRow: $imageRow, imageCol: $imageCol)';
+}
+
+/// The part of an image one [KittyVirtualRun] draws, in physical pixels.
+///
+/// Offsets are from the top-left of the run's first cell.
+typedef KittyVirtualSlice = ({
+  int offsetX,
+  int offsetY,
+  int sourceX,
+  int sourceY,
+  int sourceWidth,
+  int sourceHeight,
+  int destWidth,
+  int destHeight,
+});
+
+/// Collects placeholder runs from the rows of a render state.
+///
+/// Only rows libghostty flags as holding a placeholder are walked cell by cell.
+final class KittyVirtualScanner {
+  final RowIterator _rows = RowIterator();
+  final CellIterator _cells = CellIterator();
+
+  void dispose() {
+    _cells.dispose();
+    _rows.dispose();
+  }
+
+  /// Appends every run in the first [maxRows] viewport rows of [state] to
+  /// [out].
+  void scan(RenderState state, int maxRows, List<KittyVirtualRun> out) {
+    _rows.reset(state);
+    while (_rows.next()) {
+      final row = _rows.index;
+      if (row >= maxRows) break;
+      if (!_rows.hasKittyVirtualPlaceholder) continue;
+      _cells.reset(_rows);
+      _scanRow(row, out);
+    }
+  }
+
+  void _scanRow(int row, List<KittyVirtualRun> out) {
+    _PartialRun? run;
+    while (_cells.next()) {
+      if (_cells.codepoint != kittyPlaceholder) {
+        if (run != null) out.add(run.complete(row));
+        run = null;
+        continue;
+      }
+      final cell = _PartialRun.parse(_cells);
+      if (run != null && run.append(cell)) continue;
+      if (run != null) out.add(run.complete(row));
+      run = cell
+        ..imageRow ??= 0
+        ..imageCol ??= 0;
+    }
+    if (run != null) out.add(run.complete(row));
+  }
+}
+
+/// Placement data carried by one placeholder cell, before missing diacritics
+/// are resolved against the run to its left.
+final class _PartialRun {
+  final int col;
+  final int imageIdLow;
+  final int? imageIdHigh;
+  final int? placementId;
+  int? imageRow;
+  int? imageCol;
+  var width = 1;
+
+  _PartialRun({
+    required this.col,
+    required this.imageIdLow,
+    required this.imageIdHigh,
+    required this.placementId,
+    required this.imageRow,
+    required this.imageCol,
+  });
+
+  factory _PartialRun.parse(CellIterator cells) {
+    final style = cells.style;
+    final underline = style.underlineColor;
+    final placementId = underline == null ? 0 : _colorToId(underline);
+    int? imageRow, imageCol, imageIdHigh;
+    if (cells.graphemeLength > 1) {
+      // Invalid diacritics count as absent, as in ghostty and kitty.
+      final marks = cells.content.runes.skip(1).iterator;
+      if (marks.moveNext()) {
+        imageRow = kittyDiacriticIndex(marks.current);
+        if (marks.moveNext()) {
+          imageCol = kittyDiacriticIndex(marks.current);
+          if (marks.moveNext()) {
+            final high = kittyDiacriticIndex(marks.current);
+            if (high != null && high <= 0xFF) imageIdHigh = high;
+          }
+        }
+      }
+    }
+    return _PartialRun(
+      col: cells.col,
+      imageIdLow: _colorToId(style.foreground),
+      imageIdHigh: imageIdHigh,
+      placementId: placementId == 0 ? null : placementId,
+      imageRow: imageRow,
+      imageCol: imageCol,
+    );
+  }
+
+  bool append(_PartialRun next) {
+    final appendable =
+        imageIdLow == next.imageIdLow &&
+        placementId == next.placementId &&
+        (next.imageRow == null || next.imageRow == imageRow) &&
+        (next.imageCol == null || next.imageCol == imageCol! + width) &&
+        (next.imageIdHigh == null || next.imageIdHigh == imageIdHigh);
+    if (appendable) width++;
+    return appendable;
+  }
+
+  KittyVirtualRun complete(int row) => KittyVirtualRun(
+    viewportRow: row,
+    viewportCol: col,
+    width: width,
+    imageId: imageIdLow | (imageIdHigh ?? 0) << 24,
+    placementId: placementId ?? 0,
+    imageRow: imageRow ?? 0,
+    imageCol: imageCol ?? 0,
+  );
+
+  static int _colorToId(CellColor color) => switch (color) {
+    DefaultColor() => 0,
+    PaletteColor(:final index) => index,
+    RgbColor(:final r, :final g, :final b) => r << 16 | g << 8 | b,
+  };
+}
+
+/// Picks the placement whose grid a placeholder run refers to.
+///
+/// An explicit [placementId] must match exactly. Otherwise the image's virtual
+/// placement with the lowest id wins.
+KittyPlacement? kittyPlaceholderTarget(
+  Iterable<KittyPlacement> placements,
+  int imageId,
+  int placementId,
+) {
+  KittyPlacement? best;
+  for (final placement in placements) {
+    if (placement.imageId != imageId) continue;
+    if (placementId != 0) {
+      if (placement.placementId == placementId) return placement;
+      continue;
+    }
+    if (!placement.isVirtual) continue;
+    if (best == null || placement.placementId < best.placementId) {
+      best = placement;
+    }
+  }
+  return best;
+}
+
+/// Fits an image into its placement grid, preserving aspect ratio and
+/// centring it, and returns the slice that [run] draws.
+///
+/// A port of ghostty's `Placement.renderPlacement`; returns null when the run
+/// covers only the letterbox around the image.
+KittyVirtualSlice? kittyVirtualSlice({
+  required KittyVirtualRun run,
+  required KittyPlacement placement,
+  required int imageWidth,
+  required int imageHeight,
+  required int cellWidthPx,
+  required int cellHeightPx,
+}) {
+  var gridRows = placement.rows;
+  var gridCols = placement.columns;
+  if (gridRows == 0)
+    gridRows = (imageHeight + cellHeightPx - 1) ~/ cellHeightPx;
+  if (gridCols == 0) gridCols = (imageWidth + cellWidthPx - 1) ~/ cellWidthPx;
+  if (gridRows == 0 || gridCols == 0) return null;
+
+  final imgWidth = imageWidth.toDouble();
+  final imgHeight = imageHeight.toDouble();
+  final gridHeightPx = (gridRows * cellHeightPx).toDouble();
+  final gridWidthPx = (gridCols * cellWidthPx).toDouble();
+
+  double scale;
+  var padX = 0.0, padY = 0.0;
+  if (imgWidth * gridHeightPx > imgHeight * gridWidthPx) {
+    scale = gridWidthPx / (imgWidth < 1 ? 1 : imgWidth);
+    padY = (gridHeightPx - imgHeight * scale) / 2;
+  } else {
+    scale = gridHeightPx / (imgHeight < 1 ? 1 : imgHeight);
+    padX = (gridWidthPx - imgWidth * scale) / 2;
+  }
+
+  // The image's own pixel space, widened by the letterbox.
+  final scaledPadX = padX / scale;
+  final scaledPadY = padY / scale;
+  final scaledWidth = imgWidth + scaledPadX * 2;
+  final scaledHeight = imgHeight + scaledPadY * 2;
+
+  var srcWidth = scaledWidth * (run.width / gridCols);
+  var srcHeight = scaledHeight * (1 / gridRows);
+  var srcX = scaledWidth * (run.imageCol / gridCols);
+  var srcY = scaledHeight * (run.imageRow / gridRows);
+
+  var destOffsetX = 0.0, destOffsetY = 0.0;
+  var destWidth = (run.width * cellWidthPx).toDouble();
+  var destHeight = cellHeightPx.toDouble();
+
+  if (srcY < scaledPadY) {
+    final offset = scaledPadY - srcY;
+    srcHeight -= offset;
+    destOffsetY = offset;
+    destHeight -= offset * scale;
+    srcY = 0;
+    if (srcHeight > imgHeight) {
+      srcHeight = imgHeight;
+      destHeight = imgHeight * scale;
+    }
+  } else if (srcY + srcHeight > scaledHeight - scaledPadY) {
+    srcY -= scaledPadY;
+    srcHeight = scaledHeight - scaledPadY - srcY - scaledPadY;
+    destHeight = srcHeight * scale;
+  } else {
+    srcY -= scaledPadY;
+  }
+
+  if (srcX < scaledPadX) {
+    final offset = scaledPadX - srcX;
+    srcWidth -= offset;
+    destOffsetX = offset;
+    destWidth -= offset * scale;
+    srcX = 0;
+    if (srcWidth > imgWidth) {
+      srcWidth = imgWidth;
+      destWidth = imgWidth * scale;
+    }
+  } else if (srcX + srcWidth > scaledWidth - scaledPadX) {
+    srcX -= scaledPadX;
+    srcWidth = scaledWidth - scaledPadX - srcX - scaledPadX;
+    destWidth = srcWidth * scale;
+  } else {
+    srcX -= scaledPadX;
+  }
+
+  if (srcWidth <= 0 || srcHeight <= 0) return null;
+  final slice = (
+    offsetX: (destOffsetX * scale).round(),
+    offsetY: (destOffsetY * scale).round(),
+    sourceX: srcX.round(),
+    sourceY: srcY.round(),
+    sourceWidth: srcWidth.round(),
+    sourceHeight: srcHeight.round(),
+    destWidth: destWidth.round(),
+    destHeight: destHeight.round(),
+  );
+  if (slice.destWidth == 0 || slice.destHeight == 0) return null;
+  return slice;
+}
+
+/// Row, column, or image-id byte encoded by a placeholder diacritic, or null
+/// when [codepoint] is not one.
+int? kittyDiacriticIndex(int codepoint) {
+  var low = 0, high = _diacritics.length - 1;
+  while (low <= high) {
+    final mid = (low + high) >> 1;
+    final value = _diacritics[mid];
+    if (value == codepoint) return mid;
+    if (value < codepoint) {
+      low = mid + 1;
+    } else {
+      high = mid - 1;
+    }
+  }
+  return null;
+}
+
