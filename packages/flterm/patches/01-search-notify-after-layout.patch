+
+  /// A resize reaches the terminal while the view lays out, and a listener that rebuilds
+  /// then is a build scheduled mid-frame. That notification waits for the frame to end.
+  void _notifyOutsideLayout() {
+    final scheduler = SchedulerBinding.instance;
+    if (scheduler.schedulerPhase != SchedulerPhase.persistentCallbacks) {
+      notifyListeners();
+      return;
+    }
+    if (_notifyQueued) return;
+    _notifyQueued = true;
+    scheduler.addPostFrameCallback((_) {
+      _notifyQueued = false;
+      if (!_disposed) notifyListeners();
+    });
   }
 
