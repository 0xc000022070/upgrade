# scrollback compression runs a step once no animation holds a frame, and waits for the next frame instead of queueing an idle task
#
# Against flterm 3509e4219b2f47b0915c11214294c7b0d0cef601. Regenerate with `just pub flterm generate`.

diff --git a/lib/src/view/compression_scheduler.dart b/lib/src/view/compression_scheduler.dart
index f5b3393..8933320 100644
--- a/lib/src/view/compression_scheduler.dart
+++ b/lib/src/view/compression_scheduler.dart
@@ -143,12 +143,11 @@ final class CompressionScheduler {
   }
 
   static void _scheduleAtIdle(VoidCallback callback) {
-    unawaited(
-      SchedulerBinding.instance.scheduleTask(
-        callback,
-        .idle,
-        debugLabel: 'Terminal scrollback compression',
-      ),
-    );
+    final scheduler = SchedulerBinding.instance;
+    if (scheduler.transientCallbackCount == 0) {
+      Timer.run(callback);
+      return;
+    }
+    scheduler.addPostFrameCallback((_) => _scheduleAtIdle(callback));
   }
 }
