+import 'package:flutter/foundation.dart' show internal;
+import 'package:libghostty/libghostty.dart' show Position;
+
+import 'cell_range.dart';
+
+/// The box drawn around [cell] by the rules an application frames its panes with, read
+/// through [codepointAt], or null when no rule closes it on any side or [cell] is a rule.
+///
+/// A side is a rule that runs across the box: a column of vertical strokes three rows
+/// long through the press row, or a row of horizontal strokes spanning the box's columns
+/// whose ends meet a corner or tee, or the screen's edge.
+/// A lone `│` in a line of text is neither, so it does not cut the box.
+@internal
+CellRange? frameAround(
+  Position cell, {
+  required int rows,
+  required int cols,
+  required int Function(int row, int col) codepointAt,
+}) {
+  final row = cell.row;
+  final col = cell.col;
+  if (row < 0 || row >= rows || col < 0 || col >= cols) return null;
+  final under = codepointAt(row, col);
+  if (_vertical(under) || _horizontal(under)) return null;
+
+  bool sideAt(int x) {
+    if (!_vertical(codepointAt(row, x))) return false;
+    var run = 1;
+    for (var y = row - 1; y >= 0 && _vertical(codepointAt(y, x)); y--) {
+      run++;
+    }
+    for (var y = row + 1; y < rows && _vertical(codepointAt(y, x)); y++) {
+      run++;
+    }
+    return run >= 3;
+  }
+
+  var left = 0;
+  for (var x = col - 1; x >= 0; x--) {
+    if (sideAt(x)) {
+      left = x + 1;
+      break;
+    }
+  }
+  var right = cols - 1;
+  for (var x = col + 1; x < cols; x++) {
+    if (sideAt(x)) {
+      right = x - 1;
+      break;
+    }
+  }
+
+  // A pane's edge meets the sides it runs between: tmux and herdr draw a corner or a tee
+  // where it does. A table's rule inside a pane ends against the pane's plain `│` instead.
+  bool endAt(int y, int x) => x < 0 || x >= cols || _joint(codepointAt(y, x));
+
+  bool edgeAt(int y) {
+    for (var x = left; x <= right; x++) {
+      if (!_horizontal(codepointAt(y, x))) return false;
+    }
+    return endAt(y, left - 1) && endAt(y, right + 1);
+  }
+
+  var top = 0;
+  for (var y = row - 1; y >= 0; y--) {
+    if (edgeAt(y)) {
+      top = y + 1;
+      break;
+    }
+  }
+  var bottom = rows - 1;
+  for (var y = row + 1; y < rows; y++) {
+    if (edgeAt(y)) {
+      bottom = y - 1;
+      break;
+    }
+  }
+
+  if (left == 0 && right == cols - 1 && top == 0 && bottom == rows - 1) {
+    return null;
+  }
+  return CellRange(
+    start: Position(row: top, col: left),
+    end: Position(row: bottom, col: right),
+  );
+}
+
+/// Light, heavy, dashed and double lines that run through a cell top to bottom, and the
+/// corners, tees and crosses any rule meets another with.
+bool _vertical(int c) => switch (c) {
+  0x2502 || 0x2503 || 0x2506 || 0x2507 || 0x250A || 0x250B => true,
+  0x254E || 0x254F || 0x2551 => true,
+  _ => _joint(c),
+};
+
+/// The same for lines that run through a cell side to side.
+bool _horizontal(int c) => switch (c) {
+  0x2500 || 0x2501 || 0x2504 || 0x2505 || 0x2508 || 0x2509 => true,
+  0x254C || 0x254D || 0x2550 => true,
+  _ => _joint(c),
+};
+
+bool _joint(int c) =>
+    (c >= 0x250C && c <= 0x254B) || (c >= 0x2552 && c <= 0x2570);
