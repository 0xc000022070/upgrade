+  /// Each row cut to the pane's columns. A row its text fills to the pane's right edge
+  /// ran on into the next, the way a multiplexer wraps a long line, and is joined to it.
+  String _framedText(
+    Selection selection,
+    CellRange frame,
+    FormatterFormat format,
+  ) {
+    final geometry = _terminal.geometry;
+    final range = ViewportSelection.resolve(
+      selection,
+      rows: geometry.rows,
+      cols: geometry.cols,
+      viewportOffset: _terminal.scrollbar.offset,
+      frame: frame,
+    );
+    if (range == null) return '';
+    final text = StringBuffer();
+    for (var row = range.firstRow; row <= range.lastRow; row++) {
+      final start = range.startColumn(row);
+      final end = range.endColumn(row);
+      if (start >= end) {
+        if (row < range.lastRow) text.write('\n');
+        continue;
+      }
+      final line =
+          _terminal.formatSelection(
+            format: format,
+            selection: .fromRefs(
+              start: .at(
+                _terminal,
+                Position(row: row, col: start),
+                pointTag: .viewport,
+              ),
+              end: .at(
+                _terminal,
+                Position(row: row, col: end - 1),
+                pointTag: .viewport,
+              ),
+            ),
+          ) ??
+          '';
+      final trimmed = line.trimRight();
+      text.write(trimmed);
+      if (row == range.lastRow) break;
+      // A row ending in a box-drawing stroke is a drawing that fills the pane, not a
+      // line wrapped at its edge.
+      final filled =
+          end == frame.end.col + 1 &&
+          trimmed.length == line.length &&
+          line.isNotEmpty &&
+          !_boxDrawing(line.codeUnitAt(line.length - 1));
+      if (!filled) text.write('\n');
+    }
+    return text.toString();
+  }
+
   void _setTerminalSelection(Selection? value) {
