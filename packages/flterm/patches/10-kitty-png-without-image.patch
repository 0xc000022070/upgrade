+  try {
+    return decodePngRgba(bytes);
+  } on Object {
+    // A short, corrupt or hostile payload throws somewhere in the walk.
+    return null;
+  }
+}
+
+const _signature = [137, 80, 78, 71, 13, 10, 26, 10];
+
+// 64 MiB of RGBA: a payload from the remote end must not exhaust the phone.
+const _maxPixels = 4096 * 4096;
+
+const _channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4};
+const _depths = {
+  0: [1, 2, 4, 8, 16],
+  2: [8, 16],
+  3: [1, 2, 4, 8],
+  4: [8, 16],
+  6: [8, 16],
+};
+
+// Adam7 passes as x start, y start, x step, y step.
+const _adam7 = [
+  [0, 0, 8, 8],
+  [4, 0, 8, 8],
+  [0, 4, 4, 8],
+  [2, 0, 4, 4],
+  [0, 2, 2, 4],
+  [1, 0, 2, 2],
+  [0, 1, 1, 2],
+];
+
+/// Decodes a PNG into 8-bit RGBA, or returns null for one it does not accept.
+/// Throws on a malformed stream.
+DecodedImage? decodePngRgba(Uint8List png) {
+  for (var i = 0; i < _signature.length; i++) {
+    if (png[i] != _signature[i]) return null;
+  }
+  var width = 0, height = 0, depth = 0, type = -1, interlaced = false;
+  Uint8List? palette, transparency;
+  final compressed = BytesBuilder(copy: false);
+  var at = _signature.length;
+  while (at < png.length) {
+    final length = ByteData.sublistView(png, at, at + 4).getUint32(0);
+    final kind = String.fromCharCodes(png, at + 4, at + 8);
+    final body = Uint8List.sublistView(png, at + 8, at + 8 + length);
+    at += 12 + length;
+    if (kind == 'IEND') break;
+    switch (kind) {
+      case 'IHDR':
+        final header = ByteData.sublistView(body);
+        width = header.getUint32(0);
+        height = header.getUint32(4);
+        depth = body[8];
+        type = body[9];
+        if (body[10] != 0 || body[11] != 0) return null;
+        interlaced = body[12] == 1;
+      case 'PLTE':
+        palette = body;
+      case 'tRNS':
+        transparency = body;
+      case 'IDAT':
+        compressed.add(body);
+    }
+  }
+  final channels = _channels[type];
+  if (channels == null || !_depths[type]!.contains(depth)) return null;
+  if (width == 0 || height == 0 || width * height > _maxPixels) return null;
+  if (type == 3 && palette == null) return null;
+
+  final raw = ZLibDecoder().decodeBytes(compressed.takeBytes());
+  final bitsPerPixel = channels * depth;
+  final filterStep = bitsPerPixel < 8 ? 1 : bitsPerPixel >> 3;
+  final maxSample = (1 << depth) - 1;
+  final rgba = Uint8List(width * height * 4);
+
+  int sample(Uint8List line, int index) => switch (depth) {
+    16 => line[index * 2] << 8 | line[index * 2 + 1],
+    8 => line[index],
+    _ => line[index * depth >> 3] >> (8 - depth - (index * depth & 7)) & maxSample,
+  };
+  int scaled(int value) => switch (depth) {
+    16 => value >> 8,
+    8 => value,
+    _ => value * 255 ~/ maxSample,
+  };
+  int key(int index) => transparency![index * 2] << 8 | transparency[index * 2 + 1];
+
+  var pos = 0;
+  for (final [x0, y0, dx, dy] in interlaced ? _adam7 : const [[0, 0, 1, 1]]) {
+    final columns = width > x0 ? (width - x0 + dx - 1) ~/ dx : 0;
+    final rows = height > y0 ? (height - y0 + dy - 1) ~/ dy : 0;
+    if (columns == 0 || rows == 0) continue;
+    final stride = (columns * bitsPerPixel + 7) >> 3;
+    var previous = Uint8List(stride);
+    for (var row = 0; row < rows; row++) {
+      final filter = raw[pos];
+      final line = Uint8List.fromList(Uint8List.sublistView(raw, pos + 1, pos + 1 + stride));
+      pos += 1 + stride;
+      _unfilter(filter, line, previous, filterStep);
+      previous = line;
+      for (var column = 0; column < columns; column++) {
+        final out = ((y0 + row * dy) * width + x0 + column * dx) * 4;
+        final first = column * channels;
+        int r, g, b, a = 255;
+        switch (type) {
+          case 0:
+            final v = sample(line, first);
+            r = g = b = scaled(v);
+            if (transparency != null && transparency.length >= 2 && v == key(0)) a = 0;
+          case 2:
+            final (vr, vg, vb) = (sample(line, first), sample(line, first + 1), sample(line, first + 2));
+            (r, g, b) = (scaled(vr), scaled(vg), scaled(vb));
+            if (transparency != null &&
+                transparency.length >= 6 &&
+                vr == key(0) &&
+                vg == key(1) &&
+                vb == key(2)) {
+              a = 0;
+            }
+          case 3:
+            final index = sample(line, first);
+            (r, g, b) = (palette![index * 3], palette[index * 3 + 1], palette[index * 3 + 2]);
+            if (transparency != null && index < transparency.length) a = transparency[index];
+          case 4:
+            r = g = b = scaled(sample(line, first));
+            a = scaled(sample(line, first + 1));
+          default:
+            r = scaled(sample(line, first));
+            g = scaled(sample(line, first + 1));
+            b = scaled(sample(line, first + 2));
+            a = scaled(sample(line, first + 3));
+        }
+        rgba
+          ..[out] = r
+          ..[out + 1] = g
+          ..[out + 2] = b
+          ..[out + 3] = a;
+      }
+    }
+  }
+  return DecodedImage(width: width, height: height, rgba: rgba);
+}
+
+void _unfilter(int filter, Uint8List line, Uint8List previous, int step) {
+  for (var i = 0; i < line.length; i++) {
+    final left = i >= step ? line[i - step] : 0;
+    final up = previous[i];
+    final corner = i >= step ? previous[i - step] : 0;
+    final predicted = switch (filter) {
+      0 => 0,
+      1 => left,
+      2 => up,
+      3 => (left + up) >> 1,
+      4 => _paeth(left, up, corner),
+      _ => throw FormatException('png filter $filter'),
+    };
+    line[i] = (line[i] + predicted) & 0xff;
+  }
+}
+
+int _paeth(int left, int up, int corner) {
+  final p = left + up - corner;
+  final toLeft = (p - left).abs(), toUp = (p - up).abs(), toCorner = (p - corner).abs();
+  if (toLeft <= toUp && toLeft <= toCorner) return left;
+  return toUp <= toCorner ? up : corner;
 }
