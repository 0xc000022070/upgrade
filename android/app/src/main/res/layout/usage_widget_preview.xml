<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/launcher_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">


        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/agent_codex"
            android:tint="@color/launcher_codex"
            android:importantForAccessibility="no"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/launcher_codex"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="5H 12%  WEEK 34%"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/agent_claude"
            android:tint="@color/launcher_claude"
            android:importantForAccessibility="no"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/launcher_claude"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="5H 3%  WEEK 11%"/>
    </LinearLayout>
</LinearLayout>
