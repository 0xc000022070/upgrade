<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The flutter template grants this in the debug and profile manifests only,
         so a release build reached nothing and every host came back unreachable. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- API 34+ makes the foreground service type a manifest declaration, and
         specialUse is the only one that fits an app holding ssh connections open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- SAVE on a crop writes the gallery; from Android 10 the app's own media need no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="Upgrade"
        android:name=".UpgradeApplication"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name=".OutgoingProvider"
            android:authorities="${applicationId}.outgoing"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".TransferService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <receiver
            android:name=".TransferStopReceiver"
            android:exported="false" />
        <service
            android:name=".ChatService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the end-to-end encrypted chat node the user joined connected to its peer-to-peer network, so messages from their contacts arrive and raise a notification while the app is not in front."/>
        </service>
        <service
            android:name=".LinuxService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Linux userland the user installed in the app, so its terminals and the programs started in them keep running while the app is not in front."/>
        </service>
        <receiver
            android:name=".LinuxStopReceiver"
            android:exported="false" />
        <!-- The plugin declares the service without a type, which an API 34+ device
             refuses to start. The override names it and the subtype Google wants. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:exported="false"
            tools:replace="android:foregroundServiceType,android:stopWithTask">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one ssh connection per configured host open so a blocked agent can raise a status-bar alert while the app is not in front."/>
        </service>
        <receiver
            android:name=".LauncherWidget"
            android:label="@string/launcher_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/launcher_widget_info"/>
        </receiver>
        <receiver
            android:name=".SendWidget"
            android:label="@string/send_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/send_widget_info"/>
        </receiver>
        <receiver
            android:name=".UsageWidget"
            android:label="@string/usage_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_info"/>
        </receiver>
        <service
            android:name=".SendRowsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false"/>
        <activity
            android:name=".ComposeDoor"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="dev.luisnquin.upgrade.compose"
            android:theme="@android:style/Theme.NoDisplay"/>
        <activity
            android:name=".ComposeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:taskAffinity="dev.luisnquin.upgrade.compose"
            android:theme="@style/ComposeTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"/>
        <!-- flutter_local_notifications routes every action tap through this receiver
             and declares it nowhere itself: without the line the buttons answer nothing. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <!-- The Flutter tool reads this to generate GeneratedPluginRegistrant.java. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Package visibility: without these, an API 30+ device answers that nothing
         can handle the intent. PROCESS_TEXT is the engine's own. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
